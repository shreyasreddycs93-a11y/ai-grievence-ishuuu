# Backend API base URL (no trailing slash). Leave unset/empty in the unified
# single-origin setup (Backend serves API + all 3 apps on one port) — the
# app then calls the API relative to its own origin.
VITE_API_BASE_URL=

# Only needed if serving the citizen/officer apps from separate hosts —
# in the unified setup they default to same-origin /citizen/ and /officer/.
# VITE_CITIZEN_URL=http://localhost:5180
# VITE_OFFICER_URL=http://localhost:5175
