# Leave empty (or omit the file) to call the API on the same origin — that's
# how the app is deployed, with one FastAPI process serving /citizen/ and the
# API together. Set it only when running `npm run dev` against a backend on a
# different origin.
VITE_API_BASE_URL=http://localhost:8000

# Opt-in demo mode: serves hardcoded fixtures from src/lib/mockApi.ts instead
# of calling the backend, and shows a "Demo Mode" badge in the header. Must
# stay unset outside offline demos — every user sees the same fake data.
# VITE_USE_MOCK=true
