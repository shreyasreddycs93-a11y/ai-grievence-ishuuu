{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "bash build-vercel.sh",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/citizen/:path((?!assets/).*)",
      "destination": "/citizen/index.html"
    },
    {
      "source": "/officer/:path((?!assets/).*)",
      "destination": "/officer/index.html"
    }
  ]
}
